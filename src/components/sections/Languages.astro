---
import type { Resume } from '@/content/config';

const { data } = Astro.props;
const { languages } = data as Resume;
---

<ul>
  {
    languages.map(({ language, fluency }) => (
      <li>
        <strong>{language}:</strong>
        <span>{fluency}</span>
      </li>
    ))
  }
</ul>

<style>
  ul {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 32px;
  }

  li {
    display: flex;
    gap: 8px;
    font-size: 0.85rem;
  }

  strong {
    color: var(--black-text);
    font-weight: 600;
  }

  span {
    color: var(--primary-text);
  }
</style>
