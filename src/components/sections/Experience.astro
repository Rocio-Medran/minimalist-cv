---
import type { Resume } from '@/content/config';
import { getLangFromUrl, useTranslations } from '@/i18n/utils';

const { data } = Astro.props;
const { work } = data as Resume;
const lang = getLangFromUrl(Astro.url)
const t = useTranslations(lang)
const dateLocale = lang === 'es' ? 'es-AR' : 'en-US';
---

<ul>
  {
    work.map(({ name, startDate, endDate, position, summary, isRemote, highlights, achievements }) => {
      const startDateString = new Date(startDate).toLocaleDateString(dateLocale, {
        month: 'short',
        year: 'numeric',
        timeZone: 'UTC',
      });
      const endDateString = endDate
        ? new Date(endDate).toLocaleDateString(dateLocale, {
            month: 'short',
            year: 'numeric',
            timeZone: 'UTC',
          })
        : t('currentDateString');
      return (
        <li>
          <article>
            <header>
              <div>
                <div class="name">
                <h3>{name}</h3>
                {isRemote && <span class="tag">{t('remoteString')}</span>}  
                </div>
                <h4>{position}</h4>
              </div>
              <time>
                {startDateString} - {endDateString}
              </time>
            </header>
            <footer>
              <p>{summary}</p>
              {achievements && achievements.length > 0 && (
                <ul class="achievements">
                  {achievements.map((a) => (
                    <li>{a}</li>
                  ))}
                </ul>
              )}
              {highlights && highlights.length > 0 && (
                <div class="highlights">
                  {highlights.map((h) => (
                    <span>{h}</span>
                  ))}
                </div>
              )}
            </footer>
          </article>
        </li>
      );
    })
  }
</ul>

<style>

  

  .name {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 8px;
    color: var(--black-text); 
  }

  .tag {
    border-radius: 6px;
    background-color: var(--hover-background);
    color: var(--black-text);
    font-size: 0.75rem;
    font-weight: 500;
    padding: 0.2rem 0.6rem
  }

  ul {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  article h3 {
    font-weight: 600;
    font-size: 1rem
    color: var(--black-text);
  }

  article h4 {
    font-weight: 500;
    font-size: 0.9rem;
    color: var(--black-text);
  }

  header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 8px;
  }

  time {
    font-size: 0.85rem;
    color: var(--darker-primary-text);
  }

  footer {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .achievements {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding-left: 1.1rem;
    list-style: disc;
    font-size: 0.9rem;
    color: var(--primary-text);
  }

  .achievements li::marker {
    color: var(--darker-primary-text);
  }

  .highlights {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
    font-size: 0.75rem;
  }

  .highlights span {
    border-radius: 6px;
    background: var(--hover-background);
    color: var(--secondary-text);
    font-weight: 500;
    padding: 0.2rem 0.6rem;
  }

@media print {
  ul {
    gap: 14px;
  }

  header {
    break-inside: avoid;
    break-after: avoid;
  }

  .achievements li,
  .highlights {
    break-inside: avoid;
  }
}

@media (max-width: 500px) {
  
  header {
    flex-direction: column;
    gap: 4px;
  }
}
</style>
